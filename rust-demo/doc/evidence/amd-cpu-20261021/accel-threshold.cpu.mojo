# Generated by xir-mojo emit-cpu; same stage expressions as the GPU emitter.
from std.math import exp, log, floor, inf, nan
from std.collections import List

@export("xir_cpu_stage0")
def stage0(
    b_l: Pointer[Float32, ImmutAnyOrigin],
    b_l_2: Pointer[Float32, ImmutAnyOrigin],
    b_sub: Pointer[Float32, MutAnyOrigin],
    b_mul: Pointer[Float32, MutAnyOrigin],
    b_max: Pointer[Float32, MutAnyOrigin],
    b_max_2: Pointer[Float32, MutAnyOrigin],
    b_mul_2: Pointer[Float32, MutAnyOrigin],
    n: Int32,
    element_index: Int,
) abi("C"):
    """Stage 0: %div, %sub, %gt, %f, %mul, %max, %sub_2, %max_2, %mod, %mul_2 fused, one CPU call per element."""
    var i = element_index
    if i < Int(n):
        var v_l = b_l[unsafe_offset=i]
        var v_l_2 = b_l_2[unsafe_offset=i]
        var v_div = v_l / Float32(4.0)
        var v_sub = v_div - Float32(1.0)
        var v_gt = Bool(v_sub > Float32(0.5))
        var v_f = Float32(1.0) if v_gt else Float32(0.0)
        var v_mul = v_sub * v_f
        var v_max = max(v_sub, Float32(0.0))
        var v_sub_2 = v_l_2 - Float32(4.0)
        var v_max_2 = max(v_sub_2, Float32(0.0))
        var v_mod = Float32(Int(v_sub_2) % Int(Float32(2.0)))
        var v_mul_2 = v_sub_2 * v_mod
        b_sub[unsafe_offset=i] = v_sub
        b_mul[unsafe_offset=i] = v_mul
        b_max[unsafe_offset=i] = v_max
        b_max_2[unsafe_offset=i] = v_max_2
        b_mul_2[unsafe_offset=i] = v_mul_2

def main() raises:
    var h_l: List[Float32] = [Float32(1.0), Float32(2.0), Float32(3.0), Float32(4.0), Float32(5.0), Float32(6.0), Float32(7.0), Float32(8.0)]
    var h_l_2: List[Float32] = [Float32(1.0), Float32(2.0), Float32(3.0), Float32(4.0), Float32(5.0), Float32(6.0), Float32(7.0), Float32(8.0)]
    var h_sub = List[Float32](length=8, fill=Float32(0.0))
    var h_mul = List[Float32](length=8, fill=Float32(0.0))
    var h_max = List[Float32](length=8, fill=Float32(0.0))
    var h_max_2 = List[Float32](length=8, fill=Float32(0.0))
    var h_mul_2 = List[Float32](length=8, fill=Float32(0.0))
    for i in range(8):
        stage0(h_l.unsafe_ptr().as_imm().as_unsafe_any_origin(), h_l_2.unsafe_ptr().as_imm().as_unsafe_any_origin(), h_sub.unsafe_ptr().as_unsafe_any_origin(), h_mul.unsafe_ptr().as_unsafe_any_origin(), h_max.unsafe_ptr().as_unsafe_any_origin(), h_max_2.unsafe_ptr().as_unsafe_any_origin(), h_mul_2.unsafe_ptr().as_unsafe_any_origin(), Int32(8), i)
    var failures = 0
    var expected_0: List[Float32] = [Float32(-0.75), Float32(-0.5), Float32(-0.25), Float32(0.0), Float32(0.25), Float32(0.5), Float32(0.75), Float32(1.0)]
    print("output %sub:", h_sub)
    for i in range(8):
        var got = h_sub[i]
        var want = expected_0[i]
        if not (abs(got - want) <= max(Float32(1e-6), abs(want) * Float32(1e-4))):
            failures += 1
    var expected_1: List[Float32] = [Float32(-0.0), Float32(-0.0), Float32(-0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.75), Float32(1.0)]
    print("output %mul:", h_mul)
    for i in range(8):
        var got = h_mul[i]
        var want = expected_1[i]
        if not (abs(got - want) <= max(Float32(1e-6), abs(want) * Float32(1e-4))):
            failures += 1
    var expected_2: List[Float32] = [Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.25), Float32(0.5), Float32(0.75), Float32(1.0)]
    print("output %max:", h_max)
    for i in range(8):
        var got = h_max[i]
        var want = expected_2[i]
        if not (abs(got - want) <= max(Float32(1e-6), abs(want) * Float32(1e-4))):
            failures += 1
    var expected_3: List[Float32] = [Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(1.0), Float32(2.0), Float32(3.0), Float32(4.0)]
    print("output %max_2:", h_max_2)
    for i in range(8):
        var got = h_max_2[i]
        var want = expected_3[i]
        if got != want:
            failures += 1
    var expected_4: List[Float32] = [Float32(-3.0), Float32(0.0), Float32(-1.0), Float32(0.0), Float32(1.0), Float32(0.0), Float32(3.0), Float32(0.0)]
    print("output %mul_2:", h_mul_2)
    for i in range(8):
        var got = h_mul_2[i]
        var want = expected_4[i]
        if got != want:
            failures += 1
    print("backend: Mojo CPU")
    print("RESULT:", failures, "mismatched elements")
    if failures != 0:
        raise Error("CPU outputs disagree with oracle")
