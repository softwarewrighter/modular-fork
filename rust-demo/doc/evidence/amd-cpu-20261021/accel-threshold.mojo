# accel-threshold.mojo: generated by xir-mojo (Rust) from accel-threshold.xir. Do not edit.
# N = 8 elements, 1 fused kernel stage(s), 0 reduction(s), 7 device buffer(s).
# i64 in the IR, carried as Float32 on the device (exact below 2^24): %l_2, %r_5, %sub_2, %r_6, %max_2, %r_7, %mod, %mul_2.

from std.math import exp, log, floor, inf, nan
from std.memory import unsafe_stack_allocation
from std.runtime import initialize_runtime
from std.sys import has_accelerator

from max.gpu import block_dim, block_idx, thread_idx
from max.gpu.host import DeviceContext
from max.gpu.sync import barrier

comptime N = 8
comptime TPB = 256
comptime BLOCKS = (N + TPB - 1) // TPB

def stage0(
    b_l: Pointer[Float32, ImmutAnyOrigin],
    b_l_2: Pointer[Float32, ImmutAnyOrigin],
    b_sub: Pointer[Float32, MutAnyOrigin],
    b_mul: Pointer[Float32, MutAnyOrigin],
    b_max: Pointer[Float32, MutAnyOrigin],
    b_max_2: Pointer[Float32, MutAnyOrigin],
    b_mul_2: Pointer[Float32, MutAnyOrigin],
    n: Int32,
):
    """Stage 0: %div, %sub, %gt, %f, %mul, %max, %sub_2, %max_2, %mod, %mul_2 fused, one thread per element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        var v_l = b_l[unsafe_offset=i]
        var v_l_2 = b_l_2[unsafe_offset=i]
        var v_div = v_l / Float32(4.0)
        var v_sub = v_div - Float32(1.0)
        var v_gt = Bool(v_sub > Float32(0.5))
        var v_f = Float32(1.0) if v_gt else Float32(0.0)
        var v_mul = v_sub * v_f
        var v_max = max(v_sub, Float32(0.0))
        var v_sub_2 = v_l_2 - Float32(4.0)
        var v_max_2 = max(v_sub_2, Float32(0.0))
        var v_mod = Float32(Int(v_sub_2) % Int(Float32(2.0)))
        var v_mul_2 = v_sub_2 * v_mod
        b_sub[unsafe_offset=i] = v_sub
        b_mul[unsafe_offset=i] = v_mul
        b_max[unsafe_offset=i] = v_max
        b_max_2[unsafe_offset=i] = v_max_2
        b_mul_2[unsafe_offset=i] = v_mul_2


def trace(
    block_of: Pointer[Int32, MutAnyOrigin],
    thread_of: Pointer[Int32, MutAnyOrigin],
    n: Int32,
):
    """Provenance: which block and thread computed each element."""
    var i = Int(block_idx.x * block_dim.x + thread_idx.x)
    if i < Int(n):
        block_of[unsafe_offset=i] = Int32(block_idx.x)
        thread_of[unsafe_offset=i] = Int32(thread_idx.x)


@export("xir_init")
def xir_init() abi("C") -> Int32:
    """Initializes the Mojo runtime; 1 when this build targets a GPU, else 0."""
    initialize_runtime()
    comptime if has_accelerator():
        return 1
    else:
        return 0


@export("xir_device_info")
def xir_device_info(buf: Pointer[UInt8, MutAnyOrigin], cap: Int64) abi("C") -> Int64:
    """Writes `api=...;name=...` for the device the kernels run on; its length, or -1."""
    initialize_runtime()
    try:
        var ctx = DeviceContext()
        var s = String("api=", ctx.api(), ";name=", ctx.name())
        var bytes = s.as_bytes()
        var n = min(len(bytes), Int(cap))
        for i in range(n):
            buf[unsafe_offset=i] = bytes[i]
        return Int64(n)
    except e:
        return -1


@export("xir_launch")
def xir_launch(blocks: Pointer[Int32, MutAnyOrigin], tpb: Pointer[Int32, MutAnyOrigin]) abi("C") -> Int32:
    """The launch geometry every elementwise kernel here uses."""
    blocks[unsafe_offset=0] = Int32(BLOCKS)
    tpb[unsafe_offset=0] = Int32(TPB)
    return 0


@export("xir_trace")
def xir_trace(
    block_of: Pointer[Int32, MutAnyOrigin],
    thread_of: Pointer[Int32, MutAnyOrigin],
    n: Int64,
) abi("C") -> Int32:
    """Runs the provenance kernel: block_of[i], thread_of[i] for each of N elements."""
    initialize_runtime()
    if Int(n) != N:
        return 2
    try:
        var ctx = DeviceContext()
        var b_dev = ctx.enqueue_create_buffer[DType.int32](N)
        var t_dev = ctx.enqueue_create_buffer[DType.int32](N)
        ctx.enqueue_function[trace](b_dev, t_dev, Int32(N), grid_dim=BLOCKS, block_dim=TPB)
        var b_host = ctx.enqueue_create_host_buffer[DType.int32](N)
        var t_host = ctx.enqueue_create_host_buffer[DType.int32](N)
        ctx.enqueue_copy(dst_buf=b_host, src_buf=b_dev)
        ctx.enqueue_copy(dst_buf=t_host, src_buf=t_dev)
        ctx.synchronize()
        for i in range(N):
            block_of[unsafe_offset=i] = b_host[i]
            thread_of[unsafe_offset=i] = t_host[i]
        return 0
    except e:
        print("xir_trace failed:", e)
        return 1


@export("xir_run")
def xir_run(
    inputs: Pointer[Pointer[Float32, ImmutAnyOrigin], ImmutAnyOrigin],
    outputs: Pointer[Pointer[Float32, MutAnyOrigin], ImmutAnyOrigin],
    n: Int64,
) abi("C") -> Int32:
    """Runs the program: inputs[k] in program order, outputs[j] in output order.

    Returns 0 when done, 2 when n is not this build's N, 1 when the device failed.
    """
    initialize_runtime()
    if Int(n) != N:
        return 2
    try:
        var ctx = DeviceContext()
        var h_l = ctx.enqueue_create_host_buffer[DType.float32](8)
        var h_l_2 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.synchronize()
        h_l[0] = Float32(1.0)
        h_l[1] = Float32(2.0)
        h_l[2] = Float32(3.0)
        h_l[3] = Float32(4.0)
        h_l[4] = Float32(5.0)
        h_l[5] = Float32(6.0)
        h_l[6] = Float32(7.0)
        h_l[7] = Float32(8.0)
        h_l_2[0] = Float32(1.0)
        h_l_2[1] = Float32(2.0)
        h_l_2[2] = Float32(3.0)
        h_l_2[3] = Float32(4.0)
        h_l_2[4] = Float32(5.0)
        h_l_2[5] = Float32(6.0)
        h_l_2[6] = Float32(7.0)
        h_l_2[7] = Float32(8.0)
        # device buffers, one per materialized value
        var b_l = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=b_l, src_buf=h_l)
        var b_sub = ctx.enqueue_create_buffer[DType.float32](8)
        var b_mul = ctx.enqueue_create_buffer[DType.float32](8)
        var b_max = ctx.enqueue_create_buffer[DType.float32](8)
        var b_l_2 = ctx.enqueue_create_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=b_l_2, src_buf=h_l_2)
        var b_max_2 = ctx.enqueue_create_buffer[DType.float32](8)
        var b_mul_2 = ctx.enqueue_create_buffer[DType.float32](8)
        # stage 0
        ctx.enqueue_function[stage0](b_l, b_l_2, b_sub, b_mul, b_max, b_max_2, b_mul_2, Int32(N), grid_dim=BLOCKS, block_dim=TPB)
        # the outputs, back to the host
        var o_0 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_0, src_buf=b_sub)
        var o_1 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_1, src_buf=b_mul)
        var o_2 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_2, src_buf=b_max)
        var o_3 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_3, src_buf=b_max_2)
        var o_4 = ctx.enqueue_create_host_buffer[DType.float32](8)
        ctx.enqueue_copy(dst_buf=o_4, src_buf=b_mul_2)
        ctx.synchronize()
        for i in range(8):
            outputs[unsafe_offset=0][unsafe_offset=i] = o_0[i]
        for i in range(8):
            outputs[unsafe_offset=1][unsafe_offset=i] = o_1[i]
        for i in range(8):
            outputs[unsafe_offset=2][unsafe_offset=i] = o_2[i]
        for i in range(8):
            outputs[unsafe_offset=3][unsafe_offset=i] = o_3[i]
        for i in range(8):
            outputs[unsafe_offset=4][unsafe_offset=i] = o_4[i]
        return 0
    except e:
        print("xir_run failed:", e)
        return 1
