export CARGO_HOME := justfile_directory() / "work/cargo"
export CARGO_TARGET_DIR := justfile_directory() / "target"

gate:
    cargo fmt --check
    cargo test --offline
    cargo clippy --offline --all-targets -- -D warnings
    for script in scripts/*.sh tests/*.sh; do bash -n "$script"; done
    bash tests/scaffold.sh
    python3 tests/select_adreno.py
    python3 tests/rusticl_container.py
    python3 tests/nvptx_to_spirv.py
    cargo fmt --manifest-path mojo-opencl-bridge/Cargo.toml --check
    cargo test --offline --manifest-path mojo-opencl-bridge/Cargo.toml
    cargo clippy --offline --manifest-path mojo-opencl-bridge/Cargo.toml --all-targets -- -D warnings
    git diff --check

setup:
    bash scripts/setup-host.sh

inventory out:
    bash scripts/inventory.sh {{quote(out)}}

gpu-check:
    cargo test --offline --test vector_add -- --ignored --nocapture
    cargo run --offline --release
