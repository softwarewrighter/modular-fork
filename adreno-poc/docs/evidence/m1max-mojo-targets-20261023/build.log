# From adreno-poc on the M1 Max, Mojo from ../rust-demo/.venv (pinned nightly).
mojo run mojo/activation_gpu.mojo                                              > metal-run.log
mojo build mojo/activation_gpu.mojo --target-accelerator=nvidia:120 --emit asm   # side file: activations.rtx5060.ptx
mojo build mojo/activation_gpu.mojo --target-accelerator=nvidia:120 --emit llvm  # side file: activations.rtx5060.nvptx.ll
mojo build mojo/activation_gpu.mojo --target-accelerator=metal:4 --emit asm      # side file: activations.apple-m4.air.ll
mojo run spirv-target-probe.mojo                                               > spirv-target-probe.log
